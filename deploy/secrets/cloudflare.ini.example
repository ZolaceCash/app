# Certbot proves the domain is ours by writing a record in its DNS at Cloudflare.
# Copy to cloudflare.ini (never committed) and put the token in.
#   cp deploy/secrets/cloudflare.ini.example deploy/secrets/cloudflare.ini
#   chmod 600 deploy/secrets/cloudflare.ini
#
# Make the token in Cloudflare: My Profile > API Tokens > Create Token > "Edit zone DNS",
# limited to this one zone. It can change DNS records of that zone and nothing else.
dns_cloudflare_api_token =
