# nginx in front of the site. ${DOMAIN} is filled in from the environment when the container
# starts (the nginx image does that for files in /etc/nginx/templates).
#
# What this file is careful about, because the site says it of itself:
# - No access log. A visitor's address is written nowhere on this server.
# - The visitor's address is not passed on to the site. Cloudflare sends it in a header; nginx
#   uses it to slow down floods, holds it in memory for that, and strips it before the request
#   goes on. The site only ever sees nginx.

# The address Cloudflare reports, used as the key for the two limits below. An empty key is not
# limited, so a request that did not come through Cloudflare is not counted: close the server's
# ports to everyone but Cloudflare (deploy/README.md).
limit_req_zone $http_cf_connecting_ip zone=orders:10m rate=20r/m;
limit_req_zone $http_cf_connecting_ip zone=signin:10m rate=10r/m;

upstream zolace_app {
  server app:3000;
  keepalive 16;
}

# Plain HTTP only ever answers with the way to HTTPS.
server {
  listen 80;
  listen [::]:80;
  server_name ${DOMAIN} www.${DOMAIN};
  access_log off;
  return 301 https://${DOMAIN}$request_uri;
}

# www goes to the bare name, so an order link has one spelling.
server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name www.${DOMAIN};
  access_log off;
  ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
  return 301 https://${DOMAIN}$request_uri;
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name ${DOMAIN};

  access_log off;
  error_log /dev/stderr warn;
  server_tokens off;

  ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:zolace:10m;
  ssl_session_timeout 1d;

  # The largest thing the site accepts is a paste of codes on the owner's stock screen.
  client_max_body_size 2m;

  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;

  proxy_http_version 1.1;
  proxy_set_header Connection "";
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-Host $host;
  proxy_set_header X-Forwarded-Proto https;
  # Not passed on: who is asking.
  proxy_set_header CF-Connecting-IP "";
  proxy_set_header X-Forwarded-For "";
  proxy_set_header X-Real-IP "";
  proxy_set_header True-Client-IP "";
  # The site streams its pages: hand each piece on as it comes.
  proxy_buffering off;
  proxy_read_timeout 60s;

  # Starting an order sets a code aside for 15 minutes, so it is the thing worth flooding.
  location = /api/orders {
    limit_req zone=orders burst=10 nodelay;
    limit_req_status 429;
    proxy_pass http://zolace_app;
  }

  # The owner's sign-in. The site itself also makes every attempt wait.
  location = /owner/login {
    limit_req zone=signin burst=5 nodelay;
    limit_req_status 429;
    proxy_pass http://zolace_app;
  }

  # The vault's lists. Public and the same for everyone, but each answer carries every funded
  # month whole, so it is not handed out without a limit.
  location /api/vault/ {
    limit_req zone=orders burst=10 nodelay;
    limit_req_status 429;
    proxy_pass http://zolace_app;
  }

  location / {
    proxy_pass http://zolace_app;
  }
}
