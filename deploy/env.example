# Every setting of a deployment, and the only file with secrets in it.
# On the server it sits beside docker-compose.yml under the name .env:
#   cp deploy/env.example .env
# .env is never committed (.gitignore).

# The site's name on the internet, without www. The certificate is made for it and for www.
DOMAIN=zolace.cash

# Where Let's Encrypt writes when a certificate is about to run out.
CERTBOT_EMAIL=

# SECRET. A Cloudflare API token that can edit the DNS of this one zone, and nothing else.
# Cloudflare: My Profile > API Tokens > Create Token > "Edit zone DNS", limited to the zone.
# Certbot uses it to prove the domain is ours.
CLOUDFLARE_API_TOKEN=

# SECRET. The owner's secret: it opens /owner and nothing else. 32 characters or more, or the
# owner's screens stay switched off. Make one with:  openssl rand -base64 48
OWNER_SECRET=

# How many days an order is kept after it closes. Seven is a placeholder.
ORDER_RETENTION_DAYS=7

# The database. Left out, it is one SQLite file on the `zolace-data` volume of this server, which
# is the default and needs nothing else. Set these two only to use a hosted libSQL database
# instead: then the orders are stored with that provider, not here. The token is a SECRET.
# DATABASE_URL=
# DATABASE_AUTH_TOKEN=
