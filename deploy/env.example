# Settings of a deployment. Copy to .env beside docker-compose.yml and fill in.
#   cp deploy/env.example .env
# .env is never committed (.gitignore).

# The site's name on the internet, without www. The certificate is made for it and for www.
DOMAIN=

# Where Let's Encrypt writes when a certificate is about to run out.
CERTBOT_EMAIL=

# The owner's secret: it opens /owner and nothing else. 32 characters or more, or the owner's
# screens stay switched off. Make one with:  openssl rand -base64 48
OWNER_SECRET=

# How many days an order is kept after it closes. Seven is a placeholder (PLAN.md).
ORDER_RETENTION_DAYS=7

# The database. Left out, it is one SQLite file on the `zolace-data` volume of this server, which
# is the default and needs nothing else. Set these two only to use a hosted libSQL database
# instead: then the orders are stored with that provider, not here.
# DATABASE_URL=
# DATABASE_AUTH_TOKEN=
