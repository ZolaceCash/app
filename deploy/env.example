# Every setting of a deployment, and the only file with secrets in it.
# On the server it sits beside docker-compose.yml under the name .env:
#   cp deploy/env.example .env
# .env is never committed (.gitignore).

# The site's name on the internet, without www. The certificate is made for it and for www.
DOMAIN=zolace.cash

# Where Let's Encrypt writes when a certificate is about to run out.
CERTBOT_EMAIL=

# SECRET. A Cloudflare API token that can edit the DNS of this one zone, and nothing else.
# Cloudflare: My Profile > API Tokens > Create Token > "Edit zone DNS", limited to the zone.
# Certbot uses it to prove the domain is ours.
CLOUDFLARE_API_TOKEN=

# SECRET. The owner's secret: it opens /owner and nothing else. 32 characters or more, or the
# owner's screens stay switched off. Make one with:  openssl rand -base64 48
OWNER_SECRET=

# How many days an order is kept after it closes. Seven is a placeholder.
ORDER_RETENTION_DAYS=7

# Real payments. Leave all three empty and the shop takes test orders only. To take ZEC:
# 1. PAYMENT_NETWORK=mainnet (or testnet, whose coins are worth nothing).
# 2. ENGINE_ENCRYPTION_KEY: SECRET. 64 hex characters, made once:  openssl rand -hex 32
#    It encrypts the viewing key where the payment engine stores it. Losing it means registering again.
# 3. ZCASH_VIEWING_KEY: SECRET. The unified full viewing key of the shop's wallet (uview1...,
#    or uviewtest1... on testnet). It lets the engine SEE payments. It cannot spend them. Never
#    put the wallet's seed phrase anywhere on this server.
PAYMENT_NETWORK=
ENGINE_ENCRYPTION_KEY=
ZCASH_VIEWING_KEY=
# Which chain explorer the engine and the site read. Empty: the public one for the network.
CIPHERSCAN_API_URL=

# Items made when they are paid for (eSIM). SECRET: the AccessCode of your account at eSIM Access
# (console.esimaccess.com). With it, an item you give a supplier's package is bought there out of
# your balance the moment its order is paid, and handed to the buyer. It can spend that balance
# and nothing else, so keep the balance small. Empty: no such item is sold.
ESIMACCESS_CODE=

# The token's contract address (the CA). This one line is what the whole site shows: the slot on
# the home page with its copy button, the token block, the token page of the docs, the whitepaper,
# the roadmap and the vault page. Empty: they all say there is no token. To set or change it, edit
# this line and run `docker compose up -d app`; nothing is built again. It has to be a 0x address
# of 40 hex digits: anything else is read as no address. None of these is a secret.
TOKEN_ADDRESS=
# The network the token is on: 4663 is Robinhood Chain, 46630 its testnet.
TOKEN_CHAIN_ID=4663
# Where the site reads that network. The public endpoint is rate limited; the hourly count asks
# little of it. If it keeps answering "too many requests", use a provider's endpoint.
TOKEN_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# The block the contract was deployed in. Transfers are read from here on. 0 reads from the start.
TOKEN_DEPLOY_BLOCK=0

# The vault: the contract holders claim their hourly reward from (contracts/src/ZolaceVault.sol).
# Leave it empty until that contract is deployed: /vault then stays closed and the owner's payout
# screen is switched off. Not a secret.
VAULT_ADDRESS=
# SECRET. The key that signs the hourly list: the vault's contract pays a claim only against a list
# this key signed. It holds no funds and sends nothing, so its address needs no ETH and should hold
# nothing. Whoever has it could sign a list of their own, up to the vault's ceiling for all wallets:
# keep it here and nowhere else, and never keep more in the vault than a week or two needs.
# Make one on your own machine, in the project folder, with:  node deploy/vault-key.mjs
# It prints the key for this line and the address to give the vault as its signer. Empty: no list
# is signed and nobody can claim.
VAULT_SIGNER_KEY=
# Addresses that never earn, apart by commas: contracts that hold the token and could never claim.
# The curve the token is sold from, the vault and the burn addresses are left out already. Add the
# pool and the locker once the token trades in a pool. It changes the hours still to come.
VAULT_SKIP=
# What holders are rewarded in, as an asset on a chain is written: eip155:<network>/erc20:<address>.
# This is NVDA, Robinhood's stock token for NVIDIA, on Robinhood Chain. It has to be on the same
# network as the token: on the testnet (46630) point it at a test token there, or the vault stays
# closed. REWARD_SYMBOL and REWARD_DECIMALS only matter for another asset (NVDA and 18 are assumed).
REWARD_ASSET=eip155:4663/erc20:0xd0601ce157db5bdc3162bbac2a2c8af5320d9eec
REWARD_SYMBOL=NVDA
REWARD_DECIMALS=18

# The database is local without any setting here: docker-compose.yml points the site at one
# SQLite file on the `zolace-data` volume of this server (file:/app/data/zolace.db).
# Set these two only to use a hosted libSQL database instead: then the orders are stored with
# that provider, not here. The token is a SECRET.
# DATABASE_URL=
# DATABASE_AUTH_TOKEN=
