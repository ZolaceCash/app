# CipherPay on Zcash testnet, as it was run for stage 0 (PLAN.md). Copy to cipherpay.env and fill in the key.
DATABASE_URL=sqlite:/data/cipherpay.db?mode=rwc
CIPHERSCAN_API_URL=https://api.testnet.cipherscan.app
NETWORK=testnet
API_HOST=0.0.0.0
API_PORT=3080
MEMPOOL_POLL_INTERVAL_SECS=5
BLOCK_POLL_INTERVAL_SECS=15
INVOICE_EXPIRY_MINUTES=60
DATA_PURGE_DAYS=30
COINGECKO_API_URL=https://api.coingecko.com/api/v3
PRICE_CACHE_SECS=300
RUST_LOG=cipherpay=debug
# 32 random bytes as hex. It encrypts the viewing key where CipherPay stores it. Make your own:
#   openssl rand -hex 32
ENCRYPTION_KEY=
