# CipherPay on Zcash testnet, as it was run with the shop. Copy to cipherpay.env and fill in the key.
# For real money: NETWORK=mainnet and CIPHERSCAN_API_URL=https://api.mainnet.cipherscan.app
DATABASE_URL=sqlite:/data/cipherpay.db?mode=rwc
CIPHERSCAN_API_URL=https://api.testnet.cipherscan.app
NETWORK=testnet
API_HOST=0.0.0.0
API_PORT=3080
MEMPOOL_POLL_INTERVAL_SECS=5
BLOCK_POLL_INTERVAL_SECS=15
# How long an unpaid invoice is watched. The shop holds a price for 15 minutes and keeps asking
# about an order for seven days (PAYMENT_WATCH_HOURS), so that a payment that comes late is found
# and owed back: the engine has to watch at least as long. 10080 minutes is seven days.
INVOICE_EXPIRY_MINUTES=10080
# How long a paid invoice is watched for a second payment (watch.patch). Seven days.
PAID_WATCH_HOURS=168
DATA_PURGE_DAYS=30
COINGECKO_API_URL=https://api.coingecko.com/api/v3
PRICE_CACHE_SECS=300
RUST_LOG=cipherpay=debug
# 32 random bytes as hex. It encrypts the viewing key where CipherPay stores it. Make your own:
#   openssl rand -hex 32
ENCRYPTION_KEY=
