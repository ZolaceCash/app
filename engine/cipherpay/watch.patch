+/// How long a confirmed invoice is still watched for more payments, as an SQLite time modifier.
+/// PAID_WATCH_HOURS, seven days when it is not set.
+fn paid_watch_modifier() -> String {
+    let hours = std::env::var("PAID_WATCH_HOURS")
+        .ok()
+        .and_then(|v| v.parse::<i64>().ok())
+        .filter(|h| *h > 0)
+        .unwrap_or(168);
+    format!("-{} hours", hours)
+}
