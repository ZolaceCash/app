+/// Trial patch (Zolace stage 0): read the transaction with the consensus branch it names itself
+/// (bytes 8..12 of a v5+ transaction) instead of assuming NU6.3, so a transaction made after a
+/// later upgrade is not dropped without a word.
+fn branch_of(tx_bytes: &[u8]) -> BranchId {
+    if tx_bytes.len() >= 12 {
+        let id = u32::from_le_bytes([tx_bytes[8], tx_bytes[9], tx_bytes[10], tx_bytes[11]]);
+        if let Ok(branch) = BranchId::try_from(id) {
+            return branch;
+        }
+    }
+    BranchId::Nu6_3
+}
